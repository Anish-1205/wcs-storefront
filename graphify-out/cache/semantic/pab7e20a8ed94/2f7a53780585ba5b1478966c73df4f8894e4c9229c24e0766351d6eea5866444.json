{"nodes": [{"id": "docs_runbooks_secrets_and_keys", "label": "Secrets, keys and credential-loss recovery (T1.4)", "file_type": "document", "source_file": "docs/runbooks/secrets-and-keys.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_runbooks_secrets_and_keys_age_private_key_rule", "label": "age private key never leaves owner control", "file_type": "rationale", "source_file": "docs/runbooks/secrets-and-keys.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every tool takes a path; never in CI, chat, cloud folders, or logged commands. Losing it makes every backup permanently unrecoverable."}, {"id": "docs_runbooks_secrets_and_keys_three_copy_custody", "label": "Three-copy key custody with escrow", "file_type": "rationale", "source_file": "docs/runbooks/secrets-and-keys.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three survives a loss plus an inaccessible location; escrow holds the key only, separated from repo access. Second ops-repo admin keeps artifacts reachable."}, {"id": "docs_runbooks_secrets_and_keys_quarterly_test_decrypt", "label": "Quarterly test-decrypt of each copy", "file_type": "concept", "source_file": "docs/runbooks/secrets-and-keys.md", "source_location": "L61", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_runbooks_secrets_and_keys_yearly_key_rotation", "label": "Yearly age key rotation", "file_type": "concept", "source_file": "docs/runbooks/secrets-and-keys.md", "source_location": "L98", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep old key until every live artifact post-dates rotation (max 56 days); age -d accepts multiple identities."}, {"id": "docs_runbooks_secrets_and_keys_loss_procedures", "label": "Credential loss procedures"