{"nodes": [{"id": "docs_runbooks_ai_cost_controls", "label": "AI cost controls runbook", "file_type": "document", "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_runbooks_ai_cost_controls_anthropic_spend_limit", "label": "Anthropic Console spend limit (hard cap)", "file_type": "concept", "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "App caps are software and can have bugs; the provider spend limit is the only hard cap, so it must be set. Default workspace cannot be limited, so the key lives in a dedicated wcs-storefront workspace."}, {"id": "docs_runbooks_ai_cost_controls_daily_feature_caps", "label": "Per-feature daily AI caps (ai_usage_daily)", "file_type": "rationale", "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reserved atomically before a request; listing/metadata/collection/color_variants 200 per UTC day by default (AI_DAILY_CAP_<FEATURE>)."}, {"id": "docs_runbooks_ai_cost_controls_ai_kill_switch", "label": "AI_KILL_SWITCH", "file_type": "concept", "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": "L39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_runbooks_ai_cost_controls_spend_limit_pause", "label": "Spend-limit pause until next month", "file_type": "rationale", "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anthropic's spend-limit responses mean retrying before the 1st of next month fails anyway, so AI is paused and no retries are made after any error."}, {"id": "docs_runbooks_ai_cost_controls_ai_fail_closed", "label": "AI ledger fail-closed", "file_type": "rationale", "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the ledger cannot be read no AI call is made; a refusal loses nothing because deterministic fallbacks exist and AI never publishes."}, {"id": "docs_runbooks_ai_cost_controls_admin_ai_usage_page", "label": "/admin/ai-usage page", "file_type": "concept", "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": "L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_runbooks_ai_cost_controls", "target": "docs_runbooks_ai_cost_controls_anthropic_spend_limit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": null, "weight": 1.0}, {"source": "docs_runbooks_ai_cost_controls", "target": "docs_runbooks_ai_cost_controls_daily_feature_caps", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": null, "weight": 1.0}, {"source": "docs_runbooks_ai_cost_controls", "target": "docs_runbooks_ai_cost_controls_ai_kill_switch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": null, "weight": 1.0}, {"source": "docs_runbooks_ai_cost_controls", "target": "docs_runbooks_ai_cost_controls_spend_limit_pause", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/runbooks/ai-cost-controls.md", "source_location": null, "weight": 1.0}, {"source": "docs_runbooks_ai_cost_controls", "target": "docs_runbooks_ai_cost_controls_ai_fail_closed", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/runbooks/ai-cost-control