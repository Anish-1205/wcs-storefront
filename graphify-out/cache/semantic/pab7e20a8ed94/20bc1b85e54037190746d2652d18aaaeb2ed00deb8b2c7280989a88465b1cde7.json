{"nodes": [{"id": "docs_runbooks_backup_restore", "label": "Backup restore runbook (T1.3)", "file_type": "document", "source_file": "docs/runbooks/backup-restore.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_runbooks_backup_restore_restore_drill", "label": "Restore drill (scripts/restore-drill.mjs)", "file_type": "concept", "source_file": "docs/runbooks/backup-restore.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run quarterly on an artifact at least a day old; verifies against the bundle manifest, shreds plaintext and drops the DB in a finally block. Passed 16/16 on 2026-10-12."}, {"id": "docs_runbooks_backup_restore_l0_recovery", "label": "L0 database-only recovery", "file_type": "concept", "source_file": "docs/runbooks/backup-restore.md", "source_location": "L270", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RTO 4h; estimated 1h-1h50m; restore itself is seconds, time is provisioning and reconfiguration. Auth data is not restored."}, {"id": "docs_runbooks_backup_restore_l1_recovery", "label": "L1 full application recovery", "file_type": "concept", "source_file": "docs/runbooks/backup-restore.md", "source_location": "L297", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Env vars, DNS, Auth, WhatsApp, Upstash, Resend, Sentry, GitHub, cron; DNS propagation is the only item that can exceed one working day."}, {"id": "docs_runbooks_backup_restore_ledger_gap", "label": "Migration ledger gap", "file_type": "concept", "source_file": "docs/runbooks/backup-restore.md", "source_location": "L197", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dump is --schema=public so supabase_migrations is absent; manifest now records the ledger so it can be rebuilt to 001-029. Stopping at 029 is deliberate because 032 was applied by hand and left unrecorded."}, {"id": "docs_runbooks_backup_restore_privilege_prestep", "label": "Restore privilege pre-step and auth shim", "file_type": "rationale", "source_file": "docs/runbooks/backup-restore.md", "source_location": "L116", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ACLs name roles that must exist; default privileges must be revoked from anon/authenticated before restore so tables aren't readable before their ACLs apply."}, {"id": "docs_runbooks_backup_restore_rls_is_the_control", "label": "RLS, not grants, is the control", "file_type": "rationale", "source_file": "docs/runbooks/backup-restore.md", "source_location": "L187", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "anon holds ALL on 22 of 26 tables; inquiries is protected only by RLS with no SELECT policy, so the drill checks RLS state, policy counts and actual row counts."}, {"id": "docs_runbooks_backup_restore_backup_watchdogs", "label": "Backup alerts and freshness (T1.11)", "file_type": "concept", "source_file": "docs/runbooks/backup-restore.md", "source_location": "L343", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sentry Cron heartbeat, freshness.yml (30h staleness, artifact quota), cleanup job (14 daily + 8 Sunday)."}, {"id": "docs_runbooks_backup_restore_keep_alive_decision", "label": "Keep-alive decision (no extra job)", "file_type": "rationale", "source_file": "docs/runbooks/backup-restore.md", "source_location": "L362", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Daily whatsapp sweep cron and the backup pg_dump already produce database activity, preventing Supabase Free pausing."}, {"id": "docs_runbooks_backup_restore_wcs_backup_ops", "label": "wcs-backup-ops repo", "file_type": "concept", "source_file": "docs/runbooks/backup-restore.md", "source_location": "L4", "