{
  "name": "saree-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-media-variants.mjs && node scripts/snapshot-catalog-visibility.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval:ingest": "vitest run --config vitest.ingest.config.ts ingest-eval/eval.test.ts && node ingest-eval/print-report.mjs",
    "test:ingest": "vitest run --config vitest.ingest.config.ts ingest-eval/ingest.test.ts ingest-eval/behaviour.test.ts ingest-eval/hidden-media.test.ts ingest-eval/curation.test.ts ingest-eval/replies.test.ts ingest-eval/unassigned-rebuild.test.ts ingest-eval/ai-usage.test.ts ingest-eval/admin-audit.test.ts ingest-eval/inquiry-workflow.test.ts ingest-eval/lease-expiry.test.ts ingest-eval/rls-live.test.ts",
    "audit:lighthouse": "lighthouse http://localhost:3000 --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=reports/lighthouse.json --quiet",
    "check:env": "node scripts/check-env.mjs --production",
    "media:colours": "node scripts/extract-colour-variants.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.73.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "15.5.27",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^4.0.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.28",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
